generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  ownedClassrooms    Classroom[]
  classroomMembers   ClassroomMember[]
  questions          Question[]
  exams              Exam[]
  attempts           ExamAttempt[]
  notifications      Notification[]
  ownedCategories    QuestionCategory[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// P1: Password reset
model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Classroom {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  joinCode   String    @unique @map("join_code")
  ownerId    String    @map("owner_id") @db.Uuid
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  owner         User               @relation(fields: [ownerId], references: [id])
  members       ClassroomMember[]
  assignments   Assignment[]
  announcements Announcement[]

  @@map("classrooms")
}

model ClassroomMember {
  id          String   @id @default(uuid()) @db.Uuid
  classroomId String   @map("classroom_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  joinedAt    DateTime @default(now()) @map("joined_at")

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@map("classroom_members")
}

// P2: Classroom announcements
model Announcement {
  id          String   @id @default(uuid()) @db.Uuid
  classroomId String   @map("classroom_id") @db.Uuid
  content     String
  createdAt   DateTime @default(now()) @map("created_at")

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// P1: Question categories (hierarchical)
model QuestionCategory {
  id       String  @id @default(uuid()) @db.Uuid
  ownerId  String  @map("owner_id") @db.Uuid
  name     String
  parentId String? @map("parent_id") @db.Uuid

  owner    User               @relation(fields: [ownerId], references: [id])
  parent   QuestionCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children QuestionCategory[] @relation("CategoryTree")
  questions Question[]

  @@map("question_categories")
}

model Question {
  id           String      @id @default(uuid()) @db.Uuid
  ownerId      String      @map("owner_id") @db.Uuid
  type         String      @default("MCQ")
  content      String
  explanation  String?
  difficulty   Difficulty?
  categoryId   String?     @map("category_id") @db.Uuid
  imageUrl     String?     @map("image_url")
  correctAnswer String?    @map("correct_answer")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  owner         User              @relation(fields: [ownerId], references: [id])
  category      QuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options       QuestionOption[]
  examQuestions ExamQuestion[]
  groupItems    QuestionGroupItem[]

  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  content    String
  isCorrect  Boolean @default(false) @map("is_correct")
  position   Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

// P2: Question groups
model QuestionGroup {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  name    String

  items QuestionGroupItem[]

  @@map("question_groups")
}

model QuestionGroupItem {
  id         String @id @default(uuid()) @db.Uuid
  groupId    String @map("group_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid

  group    QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  question Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([groupId, questionId])
  @@map("question_group_items")
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GradingMode {
  ALL_OR_NOTHING
  PARTIAL
}

model Exam {
  id                    String      @id @default(uuid()) @db.Uuid
  ownerId               String      @map("owner_id") @db.Uuid
  title                 String
  description           String?
  instructions          String?
  durationSeconds       Int         @map("duration_seconds")
  availableFrom         DateTime?   @map("available_from")
  availableUntil        DateTime?   @map("available_until")
  status                ExamStatus  @default(DRAFT)
  maxAttempts           Int         @default(1) @map("max_attempts")
  showResultImmediately Boolean     @default(true) @map("show_result_immediately")
  resultsReleased       Boolean     @default(false) @map("results_released")
  shuffleQuestions      Boolean     @default(false) @map("shuffle_questions")
  shuffleOptions        Boolean     @default(false) @map("shuffle_options")
  accessCode            String?     @map("access_code")
  gradingMode           GradingMode @default(ALL_OR_NOTHING) @map("grading_mode")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  owner       User           @relation(fields: [ownerId], references: [id])
  questions   ExamQuestion[]
  assignments Assignment[]
  attempts    ExamAttempt[]

  @@map("exams")
}

model ExamQuestion {
  id               String @id @default(uuid()) @db.Uuid
  examId           String @map("exam_id") @db.Uuid
  sourceQuestionId String? @map("source_question_id") @db.Uuid
  points           Int
  position         Int
  contentSnapshot  String? @map("content_snapshot")
  optionsSnapshot  Json?   @map("options_snapshot")

  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  sourceQuestion Question? @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)
  answers        Answer[]

  @@unique([examId, position])
  @@map("exam_questions")
}

enum AssignmentStatus {
  ACTIVE
  CLOSED
}

model Assignment {
  id          String           @id @default(uuid()) @db.Uuid
  examId      String           @map("exam_id") @db.Uuid
  classroomId String           @map("classroom_id") @db.Uuid
  assignedAt  DateTime         @default(now()) @map("assigned_at")
  dueAt       DateTime?        @map("due_at")
  status      AssignmentStatus @default(ACTIVE)
  hideResults Boolean          @default(false) @map("hide_results")

  exam      Exam          @relation(fields: [examId], references: [id])
  classroom Classroom     @relation(fields: [classroomId], references: [id])
  attempts  ExamAttempt[]

  @@unique([examId, classroomId])
  @@map("assignments")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model ExamAttempt {
  id                   String        @id @default(uuid()) @db.Uuid
  examId               String        @map("exam_id") @db.Uuid
  studentId            String        @map("student_id") @db.Uuid
  assignmentId         String?       @map("assignment_id") @db.Uuid
  startedAt            DateTime      @default(now()) @map("started_at")
  expiresAt            DateTime      @map("expires_at")
  submittedAt          DateTime?     @map("submitted_at")
  status               AttemptStatus @default(IN_PROGRESS)
  score                Decimal?      @db.Decimal(10, 2)
  manualScoreOverride  Boolean       @default(false) @map("manual_score_override")
  feedback             String?
  questionOrder        Json?         @map("question_order")
  createdAt            DateTime      @default(now()) @map("created_at")

  exam       Exam        @relation(fields: [examId], references: [id])
  student    User        @relation(fields: [studentId], references: [id])
  assignment Assignment? @relation(fields: [assignmentId], references: [id])
  answers    Answer[]
  exitLogs   ExamExitLog[]

  @@index([examId, studentId])
  @@index([studentId])
  @@map("exam_attempts")
}

model Answer {
  id             String   @id @default(uuid()) @db.Uuid
  attemptId      String   @map("attempt_id") @db.Uuid
  examQuestionId String   @map("exam_question_id") @db.Uuid
  answerPayload  Json     @map("answer_payload")
  feedback       String?
  savedAt        DateTime @default(now()) @map("saved_at")

  attempt      ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestion ExamQuestion @relation(fields: [examQuestionId], references: [id])

  @@unique([attemptId, examQuestionId])
  @@map("answers")
}

// P2: Screen exit monitoring
model ExamExitLog {
  id         String    @id @default(uuid()) @db.Uuid
  attemptId  String    @map("attempt_id") @db.Uuid
  exitedAt   DateTime  @map("exited_at")
  returnedAt DateTime? @map("returned_at")

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("exam_exit_logs")
}

// P1: Notifications
enum NotificationType {
  NEW_ASSIGNMENT
  SUBMISSION_RECEIVED
  GRADING_COMPLETE
  RESULTS_RELEASED
  ANNOUNCEMENT
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}
