# Environment for API e2e tests. Loaded by test/support/load-env.ts, which
# overrides whatever is in the shell or in apps/api/.env.
# The database name MUST be lumi_test; the harness refuses anything else.
NODE_ENV=test
PORT=0
DATABASE_URL=postgresql://lumi:lumi_secret@localhost:5433/lumi_test
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=e2e-test-only-secret-not-used-anywhere-else-0123456789
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REMINDERS_ENABLED=false
