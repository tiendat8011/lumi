# ============================
# Lumi Lite — Production Config
# ============================
# Copy to .env.production and fill in all values.
# NEVER commit this file with real secrets.

# ---- PostgreSQL ----
POSTGRES_USER=lumi
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password_here
POSTGRES_DB=lumi_prod

# ---- API ----
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://lumi:CHANGE_ME_strong_random_password_here@postgres:5432/lumi_prod
CORS_ORIGIN=https://your-app.up.railway.app
JWT_SECRET=CHANGE_ME_must_be_at_least_32_characters_use_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Storage (MinIO) ----
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_BUCKET=lumi

# ---- Mail (SMTP) ----
# Leave SMTP_HOST empty to log mail instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@your-domain.com
SMTP_FROM_NAME=Lumi Lite

# ---- Application ----
APP_BASE_URL=https://your-app.up.railway.app
REMINDERS_ENABLED=true

# ---- Frontend ----
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app/api

# ---- Generate secrets with: ----
# openssl rand -hex 32    → JWT_SECRET
# openssl rand -hex 16    → POSTGRES_PASSWORD, MINIO keys
